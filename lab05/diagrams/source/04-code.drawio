        <mxCell id="32" value="BEGIN at READ COMMITTED; SELECT workshop FOR UPDATE.&#10;Run callback; COMMIT releases lock; errors roll back.&#10;StorageUnavailable: do not claim success; refresh if commit is uncertain." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#152b46;fontStyle=0;" vertex="1" parent="1">
