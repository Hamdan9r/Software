        <mxCell id="10" value="reserve(identity: AuthResult, workshopId: WorkshopId)&#10;    -&gt; ReserveResult&#10;Reject Unverified before any persistence call.&#10;Run AllocationPolicy inside Persistence.runLocked.&#10;Only Created allocation: commit, then request mail.&#10;Existing / rejected: no confirmation call." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#152b46;fontStyle=0;" vertex="1" parent="1">
