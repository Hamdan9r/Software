        <mxCell id="34" value="SQL / PostgreSQL protocol + TLS&#10;Parameterized reads, writes, transactions&#10;Returns rows / commit or failure" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#152b46;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="635" y="485" width="470" height="77.9" />
        </mxCell>
        <mxCell id="35" value="" style="rounded=1;arcSize=5;whiteSpace=wrap;html=0;fillColor=#fff7dd;strokeColor=#b59a40;strokeWidth=2;dashed=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="505" width="420" height="330" />
        </mxCell>
        <mxCell id="36" value="State and access rules" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#152b46;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="63" y="517" width="384" height="33.35" />
        </mxCell>
        <mxCell id="37" value="No direct browser-to-database access.&#10;Browser identity fields are not trusted.&#10;Signed, expiring cookie contains only&#10;Campus Identity-verified claims.&#10;Refresh queries stored workshop and&#10;reservation state; no seat counts&#10;are held only in application memory." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=19;fontColor=#152b46;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="63" y="553" width="384" height="184.55" />
        </mxCell>
        <mxCell id="38" value="" style="rounded=1;arcSize=5;whiteSpace=wrap;html=0;fillColor=#fff7dd;strokeColor=#b59a40;strokeWidth=2;dashed=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="525" y="940" width="1025" height="135" />
        </mxCell>
        <mxCell id="39" value="Consistency boundary" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#152b46;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="543" y="952" width="989" height="33.35" />
        </mxCell>
        <mxCell id="40" value="Commit the seat before calling University Mail. Mail failure preserves the seat and returns a warning.&#10;One database transaction locks a workshop row, checks duplicates/capacity, and inserts at most one seat.&#10;No background workers, queues, payment service or automatic email retries." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=19;fontColor=#152b46;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="543" y="988" width="989" height="81.95" />
        </mxCell>
        <mxCell id="41" value="Legend: blue = owned element; grey = external/supporting element; green = persistent store.&#10;Dashed boundary = named parent/scope. Arrow = labelled call/dependency; returns follow the call unless dashed.&#10;HTTPS / JSON external APIs are design assumptions; actual university API contracts are not supplied." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=16;fontColor=#152b46;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="1100" width="1510" height="69.80000000000001" />
        </mxCell>
