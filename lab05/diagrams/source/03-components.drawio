        <mxCell id="67" value="J: HTTPS / JSON confirmation" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=18;fontColor=#152b46;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1380" y="1420" width="400" height="29.3" />
        </mxCell>
        <mxCell id="68" value="" style="rounded=1;arcSize=5;whiteSpace=wrap;html=0;fillColor=#fff7dd;strokeColor=#b59a40;strokeWidth=2;dashed=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="1710" width="1610" height="315" />
        </mxCell>
        <mxCell id="69" value="Interfaces and exchanged data (C-H are in-process Python calls)" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=21;fontColor=#152b46;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="88" y="1722" width="1574" height="33.35" />
        </mxCell>
        <mxCell id="70" value="A: credential, create fields, workshopId, session cookie -&gt; HTML pages or command outcome; every board operation requires sign-in.&#10;B: HTTPS / JSON credential -&gt; verified {studentId, name, email} or rejection. C: signIn(credential) / authenticate(cookie) -&gt; session / AuthResult.&#10;D: create(student, title, startsAt, capacity), publish(student, workshopId), browse(student), attendees(student, workshopId) -&gt; authorised result.&#10;E: reserve(AuthResult, workshopId) -&gt; ReserveResult. AuthResult = VerifiedStudent {studentId, name, email} | Unverified; see 04-code for results.&#10;F: saveDraft / publishOwned / readPublished / readAttendees(student, fields or ID) -&gt; stored rows / result; owner checks precede sensitive reads.&#10;G: runLocked(workshopId, decide) -&gt; allocation result; callback reads existing/count and inserts through LockedWorkshopTx on one connection.&#10;H: requestConfirmation(reservation, workshop) -&gt; Requested | Unavailable. I: SQL rows, row lock, INSERT and COMMIT -&gt; rows / commit result.&#10;J: {to: verified email, reservationId, workshop title, start time} -&gt; accepted / unavailable. Mail error never changes stored reservations.&#10;Refresh: browse reads the database again. Remaining = capacity minus stored reservation count; only caller reservation accompanies summaries." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=19;fontColor=#152b46;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="88" y="1758" width="1574" height="235.85000000000002" />
        </mxCell>
        <mxCell id="71" value="Legend: blue = owned element; grey = external/supporting element; green = persistent store.&#10;Dashed boundary = named parent/scope. Arrow = labelled call/dependency; returns follow the call unless dashed.&#10;Keys A-J identify exact arrow interfaces. All six components are within the dashed parent boundary." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=16;fontColor=#152b46;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="2050" width="1710" height="69.80000000000001" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>