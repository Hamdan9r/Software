          <mxGeometry as="geometry" x="88" y="907" width="614" height="27.950000000000003" />
        </mxCell>
        <mxCell id="27" value="Create: generate unique ID; owner = verified studentId.&#10;Require nonempty trimmed title, start time, capacity 1-20.&#10;Owner-only publish; publishing never creates a seat.&#10;Browse: published title, time, capacity, remaining seats,&#10;and caller own reservation; no attendee list.&#10;Attendees: compare stored ownerId to caller ID first;&#10;only the owner receives names and emails." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#152b46;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="88" y="939" width="614" height="194.0" />
        </mxCell>
        <mxCell id="28" value="" style="rounded=1;arcSize=5;whiteSpace=wrap;html=0;fillColor=#e9f2ff;strokeColor=#335f92;strokeWidth=2;dashed=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1030" y="860" width="650" height="240" />
        </mxCell>
        <mxCell id="29" value="Reservation Rules" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=23;fontColor=#152b46;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1048" y="872" width="614" height="36.05" />
        </mxCell>
        <mxCell id="30" value="[Component: Python]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=17;fontColor=#335f92;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1048" y="907" width="614" height="27.950000000000003" />
        </mxCell>
        <mxCell id="31" value="Reject unverified calls before storage; check publication.&#10;Inside a locked transaction: existing first, then capacity.&#10;Commit a new seat before requesting confirmation.&#10;No duplicate seat, duplicate email or mail-failure rollback.&#10;Typed operation and concurrency proof: see 04-code." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#152b46;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1048" y="939" width="614" height="140.0" />
        </mxCell>
