        </mxCell>
        <mxCell id="35" value="Parameterized SQL, fresh reads, locked transactions.&#10;Durable workshop + reservation records and constraints." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#152b46;fontStyle=0;" vertex="1" parent="1">
