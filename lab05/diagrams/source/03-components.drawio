        <mxCell id="23" value="Gates every board operation on verified identity.&#10;Dispatches commands and renders results.&#10;Never trusts student IDs supplied by a form." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fontFamily=Arial;fontSize=20;fontColor=#152b46;fontStyle=0;" vertex="1" parent="1">
